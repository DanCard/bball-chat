#!/usr/bin/env node

import { execFileSync } from 'node:child_process';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { getConfig, saveConfig, getStatus } from '../lib/config.js';
import { isGameMoreThan3hPast } from '../lib/game_time.js';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const POLLER_BIN = path.join(__dirname, 'bball-poller');
const RENDER_SCRIPT = path.join(__dirname, '..', 'lib', 'render_image.py');

function updateRender() {
  try {
    execFileSync(RENDER_SCRIPT, [], { stdio: 'ignore' });
  } catch {}
}

const USAGE = `
Usage: bball <command>

Commands:
  status        Show current game calls and RSVP counts (default)
  attendees [s] Show confirmed attendees and maybes (alias: who)
  all           Set display to show both sites: MTV and Moffett Place
  moffett       Set display to show only Moffett Place
  mtv           Set display to show only Lunch bball MTV
  toggle        Cycle view mode: all -> moffett -> mtv -> all
  poll          Trigger an immediate background poll of Google Chat
  open [site]   Open the Google Chat space in browser (mtv or moffett)
  help          Show this help message
`;

function showStatus() {
  const config = getConfig();
  const status = getStatus();

  console.log('========================================');
  console.log(`Pickup Basketball Status [Mode: ${config.mode.toUpperCase()}]`);
  console.log('========================================\n');

  if (!status || !status.spaces) {
    console.log('No status cache found. Run `bball poll` to fetch data.');
    return;
  }

  const now = new Date();
  const rawMtv = status.spaces.mtv?.active_call;
  const rawMp = status.spaces.moffett?.active_call;

  const mtv = (rawMtv && !isGameMoreThan3hPast(rawMtv, now)) ? rawMtv : null;
  const mp = (rawMp && !isGameMoreThan3hPast(rawMp, now)) ? rawMp : null;

  console.log('1. Lunch bball MTV:');
  if (mtv) {
    const plusNote = mtv.plus_count > 0 ? ` (+${mtv.plus_count})` : '';
    console.log(`   RSVP Count : ${mtv.basketball_count} 🏀${plusNote} ${mtv.question_count > 0 ? `(${mtv.question_count} ❓)` : ''}`);
    if (mtv.attendees && mtv.attendees.length > 0) {
      console.log(`   Attendees  : ${mtv.attendees.join(', ')}`);
    }
    if (mtv.maybes && mtv.maybes.length > 0) {
      console.log(`   Maybes     : ${mtv.maybes.join(', ')}`);
    }
    console.log(`   Timing/Call: ${mtv.text}`);
    console.log(`   Organizer  : ${mtv.sender}`);
    console.log(`   Is Today   : ${mtv.is_today ? 'YES' : 'No'}`);
  } else {
    console.log('   No active game call.');
  }

  console.log('\n2. Moffett Place Basketball:');
  if (mp) {
    const plusNote = mp.plus_count > 0 ? ` (+${mp.plus_count})` : '';
    console.log(`   RSVP Count : ${mp.basketball_count} 🏀${plusNote} ${mp.question_count > 0 ? `(${mp.question_count} ❓)` : ''}`);
    if (mp.attendees && mp.attendees.length > 0) {
      console.log(`   Attendees  : ${mp.attendees.join(', ')}`);
    }
    if (mp.maybes && mp.maybes.length > 0) {
      console.log(`   Maybes     : ${mp.maybes.join(', ')}`);
    }
    console.log(`   Timing/Call: ${mp.text}`);
    console.log(`   Organizer  : ${mp.sender}`);
    console.log(`   Is Today   : ${mp.is_today ? 'YES' : 'No'}`);
  } else {
    console.log('   No active game call.');
  }

  console.log(`\nLast Updated: ${status.updated_at ? new Date(status.updated_at).toLocaleString() : 'Never'}`);
  const mtvText = mtv ? mtv.basketball_count : '-';
  const mpText = mp ? mp.basketball_count : '-';
  console.log(`Current Panel Text: MTV 1st, Moffett 2nd -> "🏀 ${mtvText} ${mpText}"`);
}

function showAttendees(targetSite) {
  const status = getStatus();
  if (!status || !status.spaces) {
    console.log('No status cache found. Run `bball poll` to fetch data.');
    return;
  }

  const site = (targetSite || '').toLowerCase();

  console.log('========================================');
  console.log('Pickup Basketball Attendees');
  console.log('========================================\n');

  const now = new Date();
  const showSite = (title, key) => {
    const space = status.spaces[key];
    const rawCall = space?.active_call;
    const call = (rawCall && !isGameMoreThan3hPast(rawCall, now)) ? rawCall : null;
    console.log(`• ${title}:`);
    if (!call) {
      console.log('  No active game call.\n');
      return;
    }
    const todayMarker = call.is_today ? ' [TODAY]' : '';
    console.log(`  Call: ${call.text}${todayMarker}`);
    const count = call.attendees?.length || call.basketball_count;
    console.log(`  Confirmed (${count}):`);
    if (call.attendees && call.attendees.length > 0) {
      for (const a of call.attendees) {
        console.log(`    - ${a}`);
      }
    } else {
      console.log('    (None listed)');
    }
    if (call.maybes && call.maybes.length > 0) {
      console.log(`  Maybe (${call.maybes.length}):`);
      for (const m of call.maybes) {
        console.log(`    - ${m}`);
      }
    }
    console.log('');
  };

  if (!site || site === 'all') {
    showSite('Lunch bball MTV', 'mtv');
    showSite('Moffett Place Basketball', 'moffett');
  } else if (site === 'mtv') {
    showSite('Lunch bball MTV', 'mtv');
  } else if (site === 'moffett' || site === 'mp') {
    showSite('Moffett Place Basketball', 'moffett');
  } else {
    console.error(`Unknown site: ${targetSite}. Use 'mtv', 'moffett', or omit for all.`);
  }
}

function setMode(newMode) {
  const validModes = ['all', 'moffett', 'mtv'];
  if (!validModes.includes(newMode)) {
    console.error(`Invalid mode: ${newMode}. Valid options: ${validModes.join(', ')}`);
    process.exit(1);
  }
  const updated = saveConfig({ mode: newMode });
  updateRender();
  console.log(`Display mode switched to: ${newMode}`);
}

function cycleMode() {
  const config = getConfig();
  const modes = ['all', 'moffett', 'mtv'];
  const currentIndex = modes.indexOf(config.mode);
  const nextMode = modes[(currentIndex + 1) % modes.length];
  saveConfig({ mode: nextMode });
  updateRender();
  console.log(`Cycled mode to: ${nextMode}`);
}

function triggerPoll() {
  console.log('Polling Google Chat spaces...');
  try {
    execFileSync(process.execPath, [POLLER_BIN, '--once'], { stdio: 'inherit' });
  } catch (err) {
    console.error('Polling failed:', err.message);
  }
}

function openChat(site) {
  const config = getConfig();
  const spaces = config.spaces || [];
  let target = spaces[0];
  if (site) {
    const s = site.toLowerCase();
    target = spaces.find(sp => sp.key === s || sp.name.toLowerCase().includes(s)) || spaces[0];
  }
  if (target && target.url) {
    console.log(`Opening ${target.name} (${target.url})...`);
    execFileSync('xdg-open', [target.url], { stdio: 'ignore' });
  }
}

const args = process.argv.slice(2);
const cmd = (args[0] || 'status').toLowerCase();

switch (cmd) {
  case 'status':
    showStatus();
    break;
  case 'attendees':
  case 'who':
  case 'players':
    showAttendees(args[1]);
    break;
  case 'all':
    setMode('all');
    break;
  case 'moffett':
  case 'mp':
    setMode('moffett');
    break;
  case 'mtv':
    setMode('mtv');
    break;
  case 'toggle':
  case 'cycle':
  case 'next':
    cycleMode();
    break;
  case 'poll':
  case 'fetch':
  case 'refresh':
    triggerPoll();
    break;
  case 'open':
    openChat(args[1]);
    break;
  case 'help':
  case '--help':
  case '-h':
    console.log(USAGE.trim());
    break;
  default:
    console.error(`Unknown command: ${cmd}\n${USAGE}`);
    process.exit(1);
}
